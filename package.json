{
  "name": "pr-blast-radius",
  "version": "0.2.0",
  "private": true,
  "description": "GitHub Action that shows reviewers what a pull request can break: Terraform, Kubernetes, workflows, IAM, network and migration changes, with a risk label",
  "license": "MIT",
  "author": "OTA-EITA",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test-coverage-exclude=test/**"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
